# Sentinel production deployment - copy to .env and fill in.
# NEVER commit the real .env (it is gitignored).

# Your NVIDIA API key for the LLM exploration loop (required for full scans).
NVIDIA_API_KEY=

# The public domain Caddy serves and gets a TLS certificate for.
# Must point at this server before first boot (DNS A/AAAA record).
SENTINEL_DOMAIN=sentinel.example.com

# Bootstrap/admin token for the dashboard API. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to auto-generate one in data/reports/.dashboard-token on first boot.
SENTINEL_TOKEN=

# Persistent state locations (container paths - compose mounts ./data at /data).
SENTINEL_DATA_DIR=/data
SENTINEL_CONFIG_DIR=/data/configs

# --- Phase 3: launch safety ---------------------------------------------------
# Block private/loopback/metadata scan targets (public deployments: keep on).
SENTINEL_PUBLIC_MODE=1

# Per-user daily scan quota (0 disables).
SENTINEL_DAILY_SCAN_LIMIT=20

# Signup mode: default is invite-only (generate codes at /invites as an admin).
# Set to 1 ONLY on private/firewalled deployments to let anyone register.
# The very first account always requires the bootstrap token regardless.
SENTINEL_OPEN_SIGNUP=

# Published abuse-contact channel (shown on the public /abuse page).
# Defaults to abuse@<SENTINEL_DOMAIN> if unset.
SENTINEL_ABUSE_EMAIL=
